<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Credo OS</vendor>
  <action id="org.credo.helper">
    <description>Change Credo OS system settings</description>
    <message>Authentication is required to change system settings (battery, boot splash, software sources).</message>
    <icon_name>credo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/credo/credo-helper</annotate>
  </action>
</policyconfig>
